# Copy to .env.local and fill from your Supabase project (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server only. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
# Scheduled jobs: long random secret (openssl rand -hex 32). Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=
